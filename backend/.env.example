# Copie este arquivo para .env e preencha com os valores reais do seu ambiente.
# NUNCA faça commit do arquivo .env (ele já está no .gitignore).

# URL de conexão com o PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/espalhaagro?schema=public"

# Porta em que o backend vai rodar
PORT=3333

# Chave/URL da API de clima (Open-Meteo é gratuita e não exige chave,
# mas deixamos a variável pronta caso troquem de provedor no futuro)
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"
